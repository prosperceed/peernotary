# PeerNotary Frontend Environment Variables (.env.example)

# Public Application & Supabase Client Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_FLW_CURRENCY=NGN

# Arc Network & Smart Contract Public Addresses
NEXT_PUBLIC_ESCROW_ADDRESS=0x5042f1114C6F272f5909f16510399986EF0D734D
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Server-Only Rust Backend & TLSNotary Service Integration
RUST_API_BASE_URL=http://127.0.0.1:7047
RUST_API_AUTH_SECRET=replace_with_32_byte_random_hex_service_api_key
TLSN_SERVICE_URL=http://127.0.0.1:7047
TLSN_SERVICE_API_KEY=replace_with_32_byte_random_hex_service_api_key
TLSN_WEBHOOK_SECRET=replace_with_32_byte_random_hex_webhook_secret

# Server-Only Supabase Service Role & Session Secrets (Never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
WALLET_SESSION_SECRET=replace_with_32_byte_random_hex_session_secret

# Server-Only Flutterwave Checkout & Webhook Verification Keys (Optional fallback when Rust handles directly)
FLW_SECRET_KEY=FLWSECK_TEST-replace_with_flutterwave_secret_key
FLW_SECRET_HASH=replace_with_flutterwave_webhook_secret_hash
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_REDIRECT_URL=http://localhost:3000/bank-checkout
FLW_CURRENCY=NGN
