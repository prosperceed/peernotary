# PeerNotary Rust TLSNotary & Cryptographic Verification Service Configuration
HOST=0.0.0.0
PORT=7047

# Shared service authentication key between Next.js and Rust (minimum 16 chars)
TLSN_SERVICE_API_KEY=replace_with_32_byte_random_hex_service_api_key

# Shared webhook secret used to sign/authenticate callbacks to Next.js /api/tlsn/webhook
TLSN_WEBHOOK_SECRET=replace_with_32_byte_random_hex_webhook_secret

# Optional Next.js webhook callback URL
TLSN_WEBHOOK_URL=http://127.0.0.1:3000/api/tlsn/webhook

# 32-byte secp256k1 Notary signing private key (hex)
NOTARY_SIGNING_KEY_HEX=replace_with_64_hex_char_secp256k1_private_key

# Strict comma-separated allowlist of HTTPS target hostnames permitted for TLSNotary proofs
TLSN_ALLOWED_HOSTNAMES=example.com,api.opayweb.com,api.gtbank.com,api.monnify.com,api.fincra.com,api.withmono.com

# Arc Testnet chain ID and deployed ArcP2PEscrowService contract address
ARC_CHAIN_ID=5042002
ESCROW_ADDRESS=0x5042f1114C6F272f5909f16510399986EF0D734D

# Resource & freshness limits
MAX_PROOF_BYTES=2097152
SESSION_TTL_SECS=900
MAX_TRANSCRIPT_AGE_SECS=3600
RUST_LOG=info,tlsn_service=debug

