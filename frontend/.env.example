# PeerNotary frontend environment (.env.example)
#
# ─── NETWORK SWITCH ───────────────────────────────────────────────────────────
# testnet = Arc Testnet + Flutterwave TEST keys (default)
# mainnet = Arc mainnet  + Flutterwave LIVE keys
# Both blocks below can be filled in at once; this one line picks which is used.
# Rebuild/redeploy after changing it (NEXT_PUBLIC_* values are baked in at build).
NEXT_PUBLIC_APP_NETWORK=testnet

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FLW_CURRENCY=NGN

# ─── TESTNET ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_TESTNET_ESCROW_ADDRESS=0xYourTestnetEscrow
NEXT_PUBLIC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Server-only
ARC_RPC_URL_TESTNET=https://rpc.testnet.arc.io
ORACLE_PRIVATE_KEY_TESTNET=0x...            # must match the testnet escrow's oracleAddress
ARC_PRIVATE_KEY_TESTNET=0x...               # deployer / optional oracle gas sponsor
FLW_SECRET_KEY_TEST=FLWSECK_TEST-...        # must start with FLWSECK_TEST-
FLW_SECRET_HASH_TEST=...                    # Flutterwave test-mode webhook hash
# Local dev without any Flutterwave key (never allowed on mainnet or in production):
FLW_ALLOW_SIMULATED_PAYMENTS=false
# Deploy script constructor args
TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
TESTNET_TREASURY_WALLET=0x...
TESTNET_ORACLE_ADDRESS=0x...

# ─── MAINNET (no defaults: every value is required before switching) ─────────
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_MAINNET_CHAIN_NAME=Arc
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_MAINNET_ESCROW_ADDRESS=
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=
# Server-only
ARC_RPC_URL_MAINNET=
ORACLE_PRIVATE_KEY_MAINNET=
ARC_PRIVATE_KEY_MAINNET=
FLW_SECRET_KEY_LIVE=FLWSECK-...             # live key; test keys are refused on mainnet
FLW_SECRET_HASH_LIVE=
RUST_API_BASE_URL_MAINNET=                  # optional separate verifier for mainnet
# Deploy script constructor args
MAINNET_USDC_ADDRESS=
MAINNET_TREASURY_WALLET=
MAINNET_ORACLE_ADDRESS=

# ─── SHARED ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
WALLET_SESSION_SECRET=...

SUPER_ADMIN_WALLETS=0xYourWhitelistedWalletAddress
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=...
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_API_HOST=https://us.posthog.com

RUST_API_BASE_URL=https://peernotary.onrender.com
RUST_API_TIMEOUT_MS=25000
TLSN_SERVICE_URL=https://peernotary.onrender.com
TLSN_VERIFIER_URL=https://peernotary.onrender.com
TLSN_SERVICE_API_KEY=...
TLSN_WEBHOOK_SECRET=...

FLW_BASE_URL=https://api.flutterwave.com/v3   # same URL for test and live; the key decides
FLW_REDIRECT_URL=http://localhost:3000/bank-checkout
FLW_CURRENCY=NGN
