# PeerNotary Rust Backend, Flutterwave Lifecycle & TLSNotary Service Configuration
HOST=0.0.0.0
PORT=7047
APP_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
RUST_LOG=info,tlsn_service=debug

# Shared service authentication key between Next.js and Rust (minimum 16 chars)
TLSN_SERVICE_API_KEY=replace_with_32_byte_random_hex_service_api_key
RUST_API_AUTH_SECRET=replace_with_32_byte_random_hex_service_api_key

# Shared webhook secret used to sign/authenticate callbacks to Next.js /api/tlsn/webhook
TLSN_WEBHOOK_SECRET=replace_with_32_byte_random_hex_webhook_secret
TLSN_WEBHOOK_URL=http://127.0.0.1:3000/api/tlsn/webhook

# Supabase & PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Flutterwave Standard Checkout, Verification & Webhook Configuration
FLW_SECRET_KEY=FLWSECK_TEST-replace_with_flutterwave_secret_key
FLW_SECRET_HASH=replace_with_flutterwave_webhook_secret_hash
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_REDIRECT_URL=http://localhost:3000/bank-checkout
FLW_CURRENCY=NGN
FLW_WEBHOOK_URL=http://localhost:7047/api/v1/webhooks/flutterwave

# Arc Network, Escrow Contract & Cryptographic Signing Keys
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ESCROW_ADDRESS=0x5042f1114C6F272f5909f16510399986EF0D734D
ARC_ESCROW_CONTRACT_ADDRESS=0x5042f1114C6F272f5909f16510399986EF0D734D
ARC_USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ARC_SIGNER_PRIVATE_KEY=replace_with_64_hex_char_secp256k1_private_key
NOTARY_SIGNING_KEY=replace_with_64_hex_char_secp256k1_private_key
NOTARY_SIGNING_KEY_HEX=replace_with_64_hex_char_secp256k1_private_key

# Trade Lifecycle & Reconciliation Worker Settings
TRADE_PAYMENT_TIMEOUT_MINUTES=20
RECONCILIATION_INTERVAL_SECONDS=30
MAX_PROVIDER_RETRIES=5

# Strict comma-separated allowlist of HTTPS target hostnames permitted for TLSNotary proofs
TLSN_ALLOWED_HOSTNAMES=example.com,api.opayweb.com,api.gtbank.com,api.monnify.com,api.fincra.com,api.withmono.com

# Resource & freshness limits
MAX_PROOF_BYTES=2097152
SESSION_TTL_SECS=900
MAX_TRANSCRIPT_AGE_SECS=3600
